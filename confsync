#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

log()  { printf '>> %s\n' "$*" >&2; }
die()  { printf 'ERRORE: %s\n' "$*" >&2; exit 1; }

# Config locale (NON versionata): definisce CONFSYNC_BUCKET (e opz. CONFSYNC_HOST_TAG).
# Vedi config.example. Tieni qui i dati di infrastruttura, fuori dal repo pubblico.
CONFSYNC_CONFIG="${CONFSYNC_CONFIG:-$HOME/.config/confsync/config}"
# shellcheck disable=SC1090
[ -f "$CONFSYNC_CONFIG" ] && . "$CONFSYNC_CONFIG"

BUCKET="${CONFSYNC_BUCKET:-}"
HOSTNAME_TAG="${CONFSYNC_HOST_TAG:-$(hostname)}"

require_bucket() {
  [ -n "$BUCKET" ] || die "CONFSYNC_BUCKET non impostato (crea $CONFSYNC_CONFIG da config.example)"
}

# Source manifest (fallback embedded minimale se assente)
if [ -f "$SCRIPT_DIR/lib/manifest.sh" ]; then
  # shellcheck source=lib/manifest.sh
  . "$SCRIPT_DIR/lib/manifest.sh"
else
  INCLUDE_DOTFILES=(.zshrc .bashrc .profile .config .claude CLAUDE.md .gitconfig)
  # shellcheck disable=SC2034
  EXCLUDE_PATTERNS=('*/Cache/*' '*.log' '*/.git/*' '*/node_modules/*')
  SECRET_PATHS=(.ssh .gnupg .netrc)
  SECRET_PATTERNS=('.env' '*.key' '*.pem' '*secret*' '*token*')
  # shellcheck disable=SC2034
  DOTFILES_ONLY_EXCLUDES=()
  # shellcheck disable=SC2034
  IGNORED_JUNK_RE=''
  CONFSYNC_MAX_FILE_MB=20
  # shellcheck disable=SC2034
  CODE_EXCLUDE_DIRS=()
  REPO_SCAN_DIRS=("$HOME/code")
fi

detect_distro() {
  local f="${CONFSYNC_OS_RELEASE:-/etc/os-release}"
  local id="" idlike=""
  if [ -r "$f" ]; then
    # shellcheck disable=SC1090
    id="$(. "$f" 2>/dev/null; printf '%s' "${ID:-}")"
    # shellcheck disable=SC1090
    idlike="$(. "$f" 2>/dev/null; printf '%s' "${ID_LIKE:-}")"
  fi
  case "$id $idlike" in
    *arch*)   echo arch ;;
    *debian*|*ubuntu*) echo debian ;;
    *fedora*|*rhel*)   echo fedora ;;
    *) echo unknown ;;
  esac
}

pkg_list_cmd() {
  case "$(detect_distro)" in
    arch)   echo "pacman -Qqe" ;;
    debian) echo "apt-mark showmanual" ;;
    fedora) echo "dnf repoquery --userinstalled --queryformat '%{name}'" ;;
    *)      echo "" ;;
  esac
}

require_deps() {
  local missing=()
  for d in tar openssl gsutil zstd; do
    if [ "${CONFSYNC_FAKE_MISSING:-}" = "$d" ] || ! command -v "$d" >/dev/null 2>&1; then
      missing+=("$d")
    fi
  done
  [ ${#missing[@]} -eq 0 ] || die "dipendenze mancanti: ${missing[*]} (installa: openssl, zstd, google-cloud-sdk)"
}

_comp_cmd()   { echo "zstd -${CONFSYNC_ZSTD_LEVEL:-10} -T0"; }
_decomp_cmd() { echo "zstd -d"; }

# tar che scrive l'archivio su stdout tollerando exit 1 (file cambiati/illeggibili
# durante la lettura: warning, non errore fatale). Exit >=2 resta fatale.
_tar_stream() {
  tar "$@"; local ec=$?
  [ "$ec" -le 1 ] && return 0 || return "$ec"
}

get_passphrase() {
  if [ -n "${CONFSYNC_PASSPHRASE:-}" ]; then printf '%s' "$CONFSYNC_PASSPHRASE"; return 0; fi
  # fallback: 1Password CLI (item "bekky passphrase") — utile su macchina nuova
  # dove esiste solo 1Password; l'app chiede conferma biometrica/master password
  local op_ref="${CONFSYNC_OP_REF:-op://Personal/bekky passphrase/password}"
  if command -v op >/dev/null; then
    local p; p="$(op read "$op_ref" 2>/dev/null)" && [ -n "$p" ] && { printf '%s' "$p"; return 0; }
  fi
  local p; read -rsp "Passphrase confsync: " p >&2; printf '\n' >&2; printf '%s' "$p"
}

sha256_of() { sha256sum "$1" | awk '{print $1}'; }

pack_encrypt() {
  local src="$1" out="$2"; shift 2
  local pass; pass="$(get_passphrase)"
  local existing=(); local p
  for p in "$@"; do [ -e "$src/$p" ] && existing+=("$p"); done
  [ ${#existing[@]} -gt 0 ] || { log "nessun path da archiviare per $out"; return 0; }
  # tar normalizzato (deterministico: ordine+mtime+owner fissi) così lo stream è
  # identico run-to-run a contenuto invariato. Lo SHA del contenuto compresso è
  # calcolato PRIMA della cifratura (openssl usa salt casuale -> i .enc non sono
  # confrontabili) in una passata dedicata, e salvato in sidecar .contentsha per il dedup.
  local tar_opts=(--sort=name --mtime='@0' --owner=0 --group=0 --numeric-owner
                  --warning=no-file-changed --ignore-failed-read)
  local ex; for ex in "${EXCLUDE_PATTERNS[@]}"; do tar_opts+=(--exclude="$ex"); done
  # DOTFILES_ONLY_EXCLUDES (credenziali gcloud/gh) solo per l'archivio dotfiles:
  # applicale a tutti gli archivi le eliminerebbe anche da secrets.tar.enc,
  # perché i --exclude di tar matchano su qualunque suffisso del path.
  if [ "${PACK_DOTFILES:-0}" = "1" ]; then
    for ex in "${DOTFILES_ONLY_EXCLUDES[@]}"; do tar_opts+=(--exclude="$ex"); done
  fi
  _tar_stream "${tar_opts[@]}" -C "$src" -cf - "${existing[@]}" \
    | eval "$(_comp_cmd)" \
    | openssl enc -aes-256-cbc -pbkdf2 -iter 600000 -salt -pass fd:3 -out "$out" 3<<<"$pass"
  _tar_stream "${tar_opts[@]}" -C "$src" -cf - "${existing[@]}" \
    | eval "$(_comp_cmd)" | sha256sum | awk '{print $1}' > "$out.contentsha"
}

decrypt_unpack() {
  local in="$1" dest="$2"
  local pass; pass="$(get_passphrase)"
  mkdir -p "$dest"
  openssl enc -d -aes-256-cbc -pbkdf2 -iter 600000 -pass fd:3 -in "$in" 3<<<"$pass" \
    | eval "$(_decomp_cmd)" \
    | tar -C "$dest" -xf -
}

is_secret_path() {
  local rel="$1" pat
  for pat in "${SECRET_PATTERNS[@]}"; do
    # shellcheck disable=SC2053,SC2254
    case "$(basename "$rel")" in $pat) return 0 ;; esac
    # shellcheck disable=SC2254
    case "$rel" in $pat) return 0 ;; esac
  done
  return 1
}

# File locali di una repo da portare nel backup: tracciati modificati/staged,
# untracked e ignorati (escluso junk e file oltre CONFSYNC_MAX_FILE_MB).
# CLAUDE.md e .claude/ restano sempre: spesso gitignored ma configurazione di
# valore non ricostruibile. I cancellati su disco vengono scartati.
list_repo_localfiles() {
  local repo="$1" rel size max=$(( CONFSYNC_MAX_FILE_MB * 1024 * 1024 ))
  # Tracciati modificati/staged: sempre, solo tetto di dimensione. Il filtro
  # junk vale per untracked e ignorati, dove sta la spazzatura rigenerabile.
  {
    if git -C "$repo" rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
      git -C "$repo" diff --name-only HEAD 2>/dev/null || true
      git -C "$repo" diff --cached --name-only 2>/dev/null || true
    else
      git -C "$repo" ls-files 2>/dev/null || true
    fi
  } | sort -u | while IFS= read -r rel; do
      [ -f "$repo/$rel" ] || continue
      size="$(stat -c %s "$repo/$rel" 2>/dev/null || printf '0')"
      [ "$size" -gt "$max" ] || printf '%s\n' "$rel"
    done
  {
    git -C "$repo" ls-files --others --exclude-standard 2>/dev/null || true
    git -C "$repo" ls-files --others --ignored --exclude-standard 2>/dev/null || true
  } | sort -u | while IFS= read -r rel; do
      [ -e "$repo/$rel" ] || continue
      # worktree git create dagli agenti: si ricreano dal repo, pesano centinaia di MB
      case "$rel" in .claude/worktrees/*) continue ;; esac
      case "$rel" in
        CLAUDE.md|*/CLAUDE.md|CLAUDE.local.md|.claude/*) ;;
        *) if [ -n "${IGNORED_JUNK_RE:-}" ] && [[ "$rel" =~ $IGNORED_JUNK_RE ]]; then continue; fi ;;
      esac
      size="$(stat -c %s "$repo/$rel" 2>/dev/null || printf '0')"
      [ "$size" -gt "$max" ] || printf '%s\n' "$rel"
    done | sort -u
}

# File dentro i REPO_SCAN_DIRS ma fuori da ogni repo git (es. cartelle di
# script o note sparse): senza .git non verrebbero mai manifestati, ma c'e'
# roba non pushatabile che non va persa. Prune delle repo (dir con .git),
# del junk (IGNORED_JUNK_RE) e dei file oltre CONFSYNC_MAX_FILE_MB; esclusi
# anche i path relativi a HOME dichiarati in CODE_EXCLUDE_DIRS.
list_nonrepo_files() {
  local dir="$1" f rel size excluded ed
  find "$dir" \
    \( -name .terraform -o -name node_modules \) -prune -o \
    -type d -exec test -d '{}/.git' \; -prune -o \
    -type f -print0 2>/dev/null \
    | while IFS= read -r -d '' f; do
        rel="${f#"$HOME"/}"
        excluded=0
        for ed in "${CODE_EXCLUDE_DIRS[@]}"; do
          if [ "$rel" = "$ed" ] || [[ "$rel" == "$ed"/* ]]; then excluded=1; break; fi
        done
        [ "$excluded" -eq 1 ] && continue
        if [ -n "${IGNORED_JUNK_RE:-}" ] && [[ "$rel" =~ $IGNORED_JUNK_RE ]]; then continue; fi
        size="$(stat -c %s "$f" 2>/dev/null || printf '0')"
        [ "$size" -gt $(( CONFSYNC_MAX_FILE_MB * 1024 * 1024 )) ] && continue
        printf '%s\n' "$rel"
      done
}

# 0 = la repo ha qualcosa da mettere nel bundle (commit locali non pushati,
# stash, o nessun remote ma con almeno una commit) — speculare a repo_bundle.
repo_has_bundle() {
  local repo="$1"
  if [ -z "$(git -C "$repo" remote get-url origin 2>/dev/null || true)" ]; then
    if git -C "$repo" rev-parse --verify --quiet HEAD >/dev/null 2>&1; then return 0; fi
    return 1
  fi
  if [ "$(git -C "$repo" log --branches --not --remotes --oneline 2>/dev/null | wc -l)" -gt 0 ]; then return 0; fi
  if [ "$(git -C "$repo" stash list 2>/dev/null | wc -l)" -gt 0 ]; then return 0; fi
  return 1
}

# Crea un bundle con cio che non e' stato pushato (commit locali + stash).
# Ritorna 0 e crea OUTFILE se c'e' qualcosa da salvare, 1 altrimenti.
# I ref temporanei refs/bekky/* vengono SEMPRE rimossi, anche su errore
# (subshell con trap: gli oggetti li recupera git, qui si pulisce solo i ref).
repo_bundle() {
  local repo="$1" out="$2"
  local remote np nstash
  remote="$(git -C "$repo" remote get-url origin 2>/dev/null || true)"
  if [ -z "$remote" ]; then
    # senza remote: salva l'intera storia, se esiste almeno una commit
    git -C "$repo" rev-parse --verify --quiet HEAD >/dev/null 2>&1 || return 1
    mkdir -p "$(dirname "$out")"
    git -C "$repo" bundle create "$out" --all >/dev/null 2>&1 || return 1
    return 0
  fi
  np="$(git -C "$repo" log --branches --not --remotes --oneline 2>/dev/null | wc -l)"
  nstash="$(git -C "$repo" stash list 2>/dev/null | wc -l)"
  if [ "$np" -eq 0 ] && [ "$nstash" -eq 0 ]; then return 1; fi
  mkdir -p "$(dirname "$out")"
  (
    local ok=0
    # refs temporanei spariti SEMPRE, anche in caso di successo; il bundle
    # parziale solo su errore
    # shellcheck disable=SC2329  # invocata via trap EXIT qui sotto
    cleanup() {
      local refs ref
      refs="$(git -C "$repo" for-each-ref --format='%(refname)' refs/bekky 2>/dev/null || true)"
      for ref in $refs; do git -C "$repo" update-ref -d "$ref" 2>/dev/null || true; done
      [ "$ok" -eq 1 ] || rm -f "$out"
    }
    trap cleanup EXIT
    local i sref srefs=()
    for ((i=0; i<nstash; i++)); do
      git -C "$repo" update-ref "refs/bekky/stash/$i" "stash@{$i}"
    done
    local args=(--branches)
    if [ "$nstash" -gt 0 ]; then
      # refs concreti: git rifiuta un glob davanti a --not ("must come before
      # non-option arguments") e con reftable lo shell glob non matcha.
      while IFS= read -r sref; do srefs+=("$sref"); done \
        < <(git -C "$repo" for-each-ref --format='%(refname)' refs/bekky/stash 2>/dev/null || true)
      args+=("${srefs[@]}")
    fi
    args+=(--not --remotes)
    if ! berr="$(git -C "$repo" bundle create "$out" "${args[@]}" 2>&1)"; then
      if [ "$nstash" -gt 0 ] && grep -q empty <<<"$berr"; then
        # bundle vuoto per via del solo --not --remotes: riprova includendo
        # gli stash senza quel filtro
        git -C "$repo" bundle create "$out" --branches "${srefs[@]}" >/dev/null 2>&1 || return 1
      else
        printf '%s\n' "$berr" >&2
        return 1
      fi
    fi
    ok=1
  )
  return $?
}

collect_repos() {
  local out="$1"; local first=1
  { printf '['
    local d repo remote branch bund
    for d in "${REPO_SCAN_DIRS[@]}"; do
      [ -d "$d" ] || continue
      # prune di .terraform e node_modules: moduli terraform scaricati e
      # dipendenze sono repo git spurie, non vanno manifestate.
      while IFS= read -r -d '' gitdir; do
        repo="$(dirname "$gitdir")"
        remote="$(git -C "$repo" remote get-url origin 2>/dev/null || echo "")"
        branch="$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
        bund=0; repo_has_bundle "$repo" && bund=1
        [ $first -eq 1 ] || printf ','
        first=0
        printf '{"path":"%s","remote":"%s","branch":"%s","bundle":"%s"}' \
          "$repo" "$remote" "$branch" "$bund"
      done < <(find "$d" \( -name .terraform -o -name node_modules \) -prune \
               -o -type d -name .git -prune -print0 2>/dev/null)
    done
    printf ']'
  } > "$out"
}

# Forza l'account definito in config: l'account gcloud "attivo" sulla macchina
# cambia durante il lavoro (clienti diversi) e non deve influenzare il backup.
GSUTIL() {
  if [ -n "${CONFSYNC_ACCOUNT:-}" ]; then
    CLOUDSDK_CORE_ACCOUNT="$CONFSYNC_ACCOUNT" "${CONFSYNC_GSUTIL:-gsutil}" "$@"
  else
    "${CONFSYNC_GSUTIL:-gsutil}" "$@"
  fi
}

gcs_latest_sha() {
  local ts; ts="$(GSUTIL cat "$BUCKET/$HOSTNAME_TAG/latest" 2>/dev/null || true)"
  [ -n "$ts" ] || { echo ""; return 0; }
  GSUTIL cat "$BUCKET/$HOSTNAME_TAG/$ts/BUNDLE.sha" 2>/dev/null || echo ""
}

gcs_upload() {
  local dir="$1" ts="$2"
  GSUTIL -m cp -r "$dir"/* "$BUCKET/$HOSTNAME_TAG/$ts/" >/dev/null
  printf '%s' "$ts" | GSUTIL cp - "$BUCKET/$HOSTNAME_TAG/latest" >/dev/null
}

gcs_fetch_latest() {
  local dest="$1"; mkdir -p "$dest"
  local ts; ts="$(GSUTIL cat "$BUCKET/$HOSTNAME_TAG/latest" 2>/dev/null || true)"
  [ -n "$ts" ] || die "nessun backup trovato per host $HOSTNAME_TAG"
  GSUTIL -m cp -r "$BUCKET/$HOSTNAME_TAG/$ts/*" "$dest"/ >/dev/null 2>&1 \
    || die "download del backup $ts fallito"
  [ -f "$dest/MANIFEST.txt" ] || die "download incompleto: MANIFEST.txt assente"
  echo "$ts"
}

verify_manifest() {
  local dir="$1"
  [ -f "$dir/MANIFEST.txt" ] || die "MANIFEST.txt assente: backup corrotto"
  local sha f
  while read -r sha f; do
    [ -f "$dir/$f" ] || die "file mancante nel download: $f (restore parziale/corrotto)"
    [ "$(sha256_of "$dir/$f")" = "$sha" ] || die "checksum non valido per $f"
  done < "$dir/MANIFEST.txt"
}

cmd_backup() {
  require_deps; require_bucket
  local ts; ts="$(date -u +%Y%m%dT%H%M%SZ)"
  local work; work="${CONFSYNC_WORKDIR_KEEP:-$(mktemp -d)}"; mkdir -p "$work"
  # shellcheck disable=SC2064  # espansione immediata voluta: $work fuori scope all'EXIT
  [ -n "${CONFSYNC_WORKDIR_KEEP:-}" ] || trap "rm -rf '$work'" EXIT

  log "raccolgo dotfiles"
  PACK_DOTFILES=1 pack_encrypt "$HOME" "$work/dotfiles.tar.enc" "${INCLUDE_DOTFILES[@]}"

  log "raccolgo secrets"
  local secstage="$work/.sec"; mkdir -p "$secstage"
  local p
  for p in "${SECRET_PATHS[@]}"; do
    [ -e "$HOME/$p" ] && { mkdir -p "$secstage/$(dirname "$p")"; cp -a "$HOME/$p" "$secstage/$p"; }
  done

  log "scansiono repo"
  collect_repos "$work/repos.manifest.json"
  local localstage="$work/.local"; mkdir -p "$localstage"
  local bundstage="$work/.bundles"; mkdir -p "$bundstage"
  local repo rel base d
  while IFS= read -r repo; do
    [ -n "$repo" ] || continue
    base="${repo#"$HOME"/}"
    # commit/stash non pushati in un bundle (niente va perso)
    if repo_bundle "$repo" "$bundstage/$base/repo.bundle"; then
      log "bundle repo: $base"
    fi
    while IFS= read -r rel; do
      [ -n "$rel" ] || continue
      if is_secret_path "$rel"; then
        mkdir -p "$secstage/$base/$(dirname "$rel")"
        cp -a "$repo/$rel" "$secstage/$base/$rel" 2>/dev/null || true
      else
        mkdir -p "$localstage/$base/$(dirname "$rel")"
        cp -a "$repo/$rel" "$localstage/$base/$rel" 2>/dev/null || true
      fi
    done < <(list_repo_localfiles "$repo")
  done < <(grep -o '"path":"[^"]*"' "$work/repos.manifest.json" | sed 's/"path":"//;s/"$//')

  # File dentro i REPO_SCAN_DIRS ma fuori da ogni repo (script, note sparse):
  # stessa destinazione dei file locali di repo, con lo stesso routing secrets.
  for d in "${REPO_SCAN_DIRS[@]}"; do
    [ -d "$d" ] || continue
    while IFS= read -r rel; do
      [ -n "$rel" ] || continue
      if is_secret_path "$rel"; then
        mkdir -p "$secstage/$(dirname "$rel")"
        cp -a "$HOME/$rel" "$secstage/$rel" 2>/dev/null || true
      else
        mkdir -p "$localstage/$(dirname "$rel")"
        cp -a "$HOME/$rel" "$localstage/$rel" 2>/dev/null || true
      fi
    done < <(list_nonrepo_files "$d")
  done

  pack_encrypt "$secstage"    "$work/secrets.tar.enc"          .
  pack_encrypt "$localstage"  "$work/repo-localfiles.tar.enc"  .
  pack_encrypt "$bundstage"   "$work/repo-bundles.tar.enc"     .
  rm -rf "$secstage" "$localstage" "$bundstage"

  log "lista pacchetti"
  local plc; plc="$(pkg_list_cmd)"
  if [ -n "$plc" ]; then eval "$plc" > "$work/packages.txt" 2>/dev/null || true; fi
  # La distro di origine serve al restore per capire se i nomi dei pacchetti
  # sono utilizzabili o solo indicativi (migrazione tra distro diverse).
  detect_distro > "$work/packages.distro"
  # $HOME di origine: se il nuovo sistema ha username diverso, i path assoluti
  # dentro unit systemd, .desktop e config vanno riscritti (scripts/rehome.sh).
  printf '%s' "$HOME" > "$work/origin.home"
  command -v flatpak >/dev/null 2>&1 && \
    flatpak list --app --columns=application >> "$work/packages.txt" 2>/dev/null || true

  log "manifest + checksum"
  # MANIFEST.txt: sha dei file CIFRATI caricati (integrità del download/restore)
  ( cd "$work" && for f in *.tar.enc repos.manifest.json packages.txt packages.distro origin.home; do
      [ -f "$f" ] && printf '%s  %s\n' "$(sha256sum "$f" | awk '{print $1}')" "$f"
    done ) > "$work/MANIFEST.txt"
  # BUNDLE.sha: firma del CONTENUTO (pre-cifratura) per il dedup — i .contentsha
  # sono deterministici, i .enc no (salt casuale). Include anche i file in chiaro.
  ( cd "$work"
    cat ./*.contentsha 2>/dev/null
    [ -f repos.manifest.json ] && sha256sum repos.manifest.json | awk '{print $1}'
    [ -f packages.txt ]        && sha256sum packages.txt        | awk '{print $1}'
  ) | sort | sha256sum | awk '{print $1}' > "$work/BUNDLE.sha"
  rm -f "$work"/*.contentsha

  local newsha oldsha; newsha="$(cat "$work/BUNDLE.sha")"; oldsha="$(gcs_latest_sha)"
  if [ "$newsha" = "$oldsha" ] && [ -n "$oldsha" ]; then
    log "nessuna modifica dall'ultimo backup — skip upload (dedup)"
    return 0
  fi
  log "upload -> $BUCKET/$HOSTNAME_TAG/$ts/"
  gcs_upload "$work" "$ts"
  log "backup completato: $ts"
}

cmd_restore() {
  require_deps; require_bucket
  local do_secrets=0 do_repos=0 do_pkgs=0 dryrun=0 assume_yes=0
  while [ $# -gt 0 ]; do case "$1" in
    --secrets) do_secrets=1 ;; --repos) do_repos=1 ;; --packages) do_pkgs=1 ;;
    --dry-run) dryrun=1 ;; --yes) assume_yes=1 ;; *) die "flag sconosciuta: $1" ;;
  esac; shift; done

  local work; work="$(mktemp -d)"

  # shellcheck disable=SC2064  # espansione immediata voluta: $work fuori scope all'EXIT

  trap "rm -rf '$work'" EXIT
  local ts; ts="$(gcs_fetch_latest "$work")"
  log "ripristino backup $ts"
  verify_manifest "$work"

  if [ $dryrun -eq 1 ]; then
    log "[dry-run] estrarrei dotfiles in $HOME; artefatti: $(ls "$work")"; return 0
  fi
  if [ $assume_yes -eq 0 ]; then
    read -rp "Sovrascrivo i dotfiles in $HOME? [y/N] " a; [ "$a" = y ] || die "annullato"
  fi
  [ -f "$work/dotfiles.tar.enc" ] && decrypt_unpack "$work/dotfiles.tar.enc" "$HOME"
  log "dotfiles ripristinati"
  # Conservato per scripts/rehome.sh: il work dir è temporaneo.
  if [ -f "$work/origin.home" ]; then
    mkdir -p "$HOME/.config/confsync"
    cp "$work/origin.home" "$HOME/.config/confsync/origin.home"
    if [ "$(cat "$work/origin.home")" != "$HOME" ]; then
      log "ATTENZIONE: backup creato con HOME=$(cat "$work/origin.home"), qui è $HOME"
      log "i path assoluti nelle config vanno riscritti: ./scripts/rehome.sh"
    fi
  fi

  if [ $do_secrets -eq 1 ] && [ -f "$work/secrets.tar.enc" ]; then
    decrypt_unpack "$work/secrets.tar.enc" "$HOME"
    chmod -R go-rwx "$HOME/.ssh" "$HOME/.gnupg" 2>/dev/null || true
    log "secrets ripristinati (permessi 600)"
  fi

  if [ $do_repos -eq 1 ] && [ -f "$work/repos.manifest.json" ]; then
    local entry path remote branch
    grep -o '{[^}]*}' "$work/repos.manifest.json" | while read -r entry; do
      path="$(echo "$entry"  | sed -n 's/.*"path":"\([^"]*\)".*/\1/p')"
      remote="$(echo "$entry"| sed -n 's/.*"remote":"\([^"]*\)".*/\1/p')"
      branch="$(echo "$entry"| sed -n 's/.*"branch":"\([^"]*\)".*/\1/p')"
      [ -n "$remote" ] || { log "skip $path (no remote)"; continue; }
      if [ ! -d "$path/.git" ]; then
        mkdir -p "$(dirname "$path")"
        if git clone "$remote" "$path"; then
          [ -n "$branch" ] && git -C "$path" checkout "$branch" 2>/dev/null || true
        else
          log "clone fallito: $path ($remote)"
        fi
      fi
    done
    [ -f "$work/repo-localfiles.tar.enc" ] && decrypt_unpack "$work/repo-localfiles.tar.enc" "$HOME"
    log "repo ripristinate"
  fi

  if [ $do_pkgs -eq 1 ] && [ -f "$work/packages.txt" ]; then
    local distro; distro="$(detect_distro)"
    local inst; case "$distro" in
      arch) inst="sudo pacman -S --needed - <" ;;
      debian) inst="sudo xargs apt-get install -y <" ;;
      fedora) inst="sudo xargs dnf install -y <" ;;
      *) inst="" ;;
    esac
    log "pacchetti da reinstallare (distro: $distro). Comando suggerito:"
    printf '  %s packages.txt\n' "${inst:-<manuale>}" >&2
    log "(esecuzione manuale per sicurezza)"
    # packages.txt porta i nomi della distro di ORIGINE: se non coincide con
    # questa, l'install in blocco muore al primo pacchetto inesistente.
    if [ -f "$work/packages.distro" ] && [ "$(cat "$work/packages.distro")" != "$distro" ]; then
      log "ATTENZIONE: lista generata su '$(cat "$work/packages.distro")', qui sei su '$distro':"
      log "i nomi non mappano 1:1, trattala come riferimento per un triage manuale"
    fi
  fi
  log "restore completato"
}

cmd_list() {
  require_deps; require_bucket
  GSUTIL ls "$BUCKET/$HOSTNAME_TAG/" 2>/dev/null || die "nessun backup"
}

cmd_diff() {
  require_deps; require_bucket
  local work; work="$(mktemp -d)"
  # shellcheck disable=SC2064  # espansione immediata voluta: $work fuori scope all'EXIT
  trap "rm -rf '$work'" EXIT
  gcs_fetch_latest "$work" >/dev/null
  local ext="$work/ext"; mkdir -p "$ext"
  [ -f "$work/dotfiles.tar.enc" ] && decrypt_unpack "$work/dotfiles.tar.enc" "$ext"
  log "differenze dotfiles (backup vs locale):"
  ( cd "$ext" && find . -type f | while read -r f; do
      diff -q "$f" "$HOME/${f#./}" >/dev/null 2>&1 || echo "DIVERSO: ${f#./}"
    done ) >&2 || true
}

usage() { cat >&2 <<EOF
confsync — backup/restore cifrato delle config OS
  confsync backup
  confsync restore [--secrets] [--repos] [--packages] [--dry-run]
  confsync list
  confsync diff
EOF
}

main() {
  case "${1:-}" in
    --source-only) return 0 ;;
    backup)  shift; cmd_backup "$@" ;;
    restore) shift; cmd_restore "$@" ;;
    list)    shift; cmd_list "$@" ;;
    diff)    shift; cmd_diff "$@" ;;
    ""|-h|--help) usage ;;
    *) die "comando sconosciuto: $1 (usa: backup|restore|list|diff)" ;;
  esac
}

main "$@"
